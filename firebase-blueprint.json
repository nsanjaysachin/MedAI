{
  "entities": {
    "User": {
      "title": "User",
      "description": "Patient user profile and medical settings",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Patient full name" },
        "email": { "type": "string", "format": "email", "description": "Patient email address" },
        "date_of_birth": { "type": "string", "description": "Patient birth date" },
        "gender": { "type": "string", "description": "Patient gender identity" },
        "created_at": { "type": "string", "description": "ISO timestamp of account creation" },
        "updated_at": { "type": "string", "description": "ISO timestamp of last profile update" }
      },
      "required": ["name", "email", "created_at"]
    },
    "MedicalDocument": {
      "title": "MedicalDocument",
      "description": "Medical report, lab result, or clinical document record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique document identifier" },
        "user_id": { "type": "string", "description": "Owning user UID" },
        "filename": { "type": "string", "description": "Original file name" },
        "file_type": { "type": "string", "description": "MIME type of document" },
        "file_url": { "type": "string", "description": "Direct file or data storage URL" },
        "document_type": { "type": "string", "description": "Type of report: Lab Results, Radiology, Prescription, etc." },
        "facility_name": { "type": "string", "description": "Healthcare facility or hospital name" },
        "physician_name": { "type": "string", "description": "Ordering or reviewing physician" },
        "report_date": { "type": "string", "description": "Date of medical test or document" },
        "status": { "type": "string", "enum": ["uploaded", "processing", "analyzed", "failed"], "description": "Processing state" },
        "summary": { "type": "string", "description": "AI-generated plain language summary" },
        "markers": { "type": "string", "description": "Serialized JSON array of extracted medical biomarkers" },
        "analysis": { "type": "string", "description": "Serialized JSON of medical analysis insights" },
        "created_at": { "type": "string", "description": "Record creation timestamp" }
      },
      "required": ["id", "user_id", "filename", "status", "created_at"]
    },
    "TimelineEvent": {
      "title": "TimelineEvent",
      "description": "Medical milestone or event in health timeline",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Event identifier" },
        "user_id": { "type": "string", "description": "User UID" },
        "title": { "type": "string", "description": "Event title" },
        "description": { "type": "string", "description": "Event details" },
        "event_date": { "type": "string", "description": "Date the event occurred" },
        "event_type": { "type": "string", "description": "lab, prescription, imaging, visit, etc." },
        "category": { "type": "string", "description": "Diagnostic category" },
        "document_id": { "type": "string", "description": "Associated document ID if any" },
        "created_at": { "type": "string", "description": "Event creation timestamp" }
      },
      "required": ["id", "user_id", "title", "event_date", "event_type", "created_at"]
    },
    "DoctorQuestion": {
      "title": "DoctorQuestion",
      "description": "Prepared question for doctor or physician appointment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Question identifier" },
        "user_id": { "type": "string", "description": "User UID" },
        "question": { "type": "string", "description": "Question text" },
        "category": { "type": "string", "description": "Category like lab_clarification, next_steps, lifestyle" },
        "is_completed": { "type": "string", "description": "Whether question has been addressed" },
        "created_at": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "user_id", "question", "created_at"]
    },
    "Medication": {
      "title": "Medication",
      "description": "Prescription, OTC drug, or supplement record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Medication ID" },
        "user_id": { "type": "string", "description": "User UID" },
        "name": { "type": "string", "description": "Medication name" },
        "dose": { "type": "string", "description": "Dosage (e.g. 500mg)" },
        "frequency": { "type": "string", "description": "Intake frequency (e.g. Daily with dinner)" },
        "start_date": { "type": "string", "description": "Start date" },
        "notes": { "type": "string", "description": "Clinical or usage notes" },
        "created_at": { "type": "string", "description": "Record creation timestamp" }
      },
      "required": ["id", "user_id", "name", "created_at"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Medical assistant Q&A conversational session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Chat session ID" },
        "user_id": { "type": "string", "description": "User UID" },
        "title": { "type": "string", "description": "Session topic summary" },
        "messages": { "type": "string", "description": "Serialized message history" },
        "created_at": { "type": "string", "description": "Session start timestamp" },
        "updated_at": { "type": "string", "description": "Last message timestamp" }
      },
      "required": ["id", "user_id", "title", "created_at"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Patient user profiles"
    },
    "/users/{userId}/documents/{documentId}": {
      "schema": "MedicalDocument",
      "description": "User medical documents and extracted records"
    },
    "/users/{userId}/timeline_events/{eventId}": {
      "schema": "TimelineEvent",
      "description": "Health timeline events"
    },
    "/users/{userId}/doctor_questions/{questionId}": {
      "schema": "DoctorQuestion",
      "description": "Questions for healthcare providers"
    },
    "/users/{userId}/medications/{medicationId}": {
      "schema": "Medication",
      "description": "Medications and supplements"
    },
    "/users/{userId}/chat_sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "AI conversational history"
    }
  }
}
